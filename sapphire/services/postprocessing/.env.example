# Postprocessing service configuration.
#
# NOTE: in Docker Compose deployments these are normally supplied via the
# shared sapphire/.env.example file, not this one. This file documents the
# settings read by app/config.py for local/bare-metal runs of this service.

DATABASE_URL=postgresql://postgres:<password>@postprocessing-db:5432/postprocessing_db
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
BATCH_SIZE=1000
CSV_FOLDER=/tmp
CONFIG_FOLDER=/config

# Public base URL used to build shareable bulletin links returned by
# POST /bulletin/share, e.g. https://<gateway-host>. Must be an
# internet-reachable HTTPS host in production. See
# doc/plans/issues/mid_prio_gi_draft_pp_bulletin_share_api.md.
PUBLIC_BULLETIN_BASE_URL=https://your-gateway-host.example
